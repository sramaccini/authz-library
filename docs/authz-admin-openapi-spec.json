        }, {
          "in" : "query",
          "name" : "offset",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AuditEntry"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Registro delle modifiche, piu' recenti prima (il delegato vede solo il proprio tenant)",
        "tags" : [ "Amministrazione RBAC" ]
      }
    },
